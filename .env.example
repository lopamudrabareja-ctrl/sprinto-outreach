# Required: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: defaults to gemini-3.8-flash
GEMINI_MODEL=

# Step 4 Option A: hunter.io free tier (25 searches/month). Leave empty to use data/contacts.json (Option B, Apollo by hand)
HUNTER_API_KEY=

# Step 7: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Every email goes here and only here
MY_EMAIL=
# Name used to sign the email
SENDER_NAME=
